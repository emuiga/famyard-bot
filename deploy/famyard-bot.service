[Unit]
Description=Famyard WhatsApp bot
After=network-online.target
Wants=network-online.target

[Service]
User=ken
WorkingDirectory=/home/ken/apps/famyard-bot
ExecStart=/home/ken/apps/famyard-bot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
